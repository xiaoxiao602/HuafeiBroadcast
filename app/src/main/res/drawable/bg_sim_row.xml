<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/green_tint_bg" />
            <stroke android:width="2dp" android:color="@color/huafei_green" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/row_idle_bg" />
            <stroke android:width="1dp" android:color="@color/edit_stroke" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
