<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 设置页:绿色竖条章节标题 -->
    <style name="SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:background">@drawable/bg_section_title</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_dark</item>
    </style>

    <!-- 设置页:白色圆角卡片 -->
    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- 设置页:卡片内行间细分隔线 -->
    <style name="CardDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <!-- 设置页:输入框上方的小标签 -->
    <style name="FieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/text_gray</item>
    </style>

    <!-- 设置页:主要操作按钮(绿底白字) -->
    <style name="PrimaryButton" parent="android:Widget.Material.Light.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:background">@drawable/btn_green</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">20sp</item>
    </style>

    <!-- 设置页:次要操作按钮(白底绿描边) -->
    <style name="SecondaryButton" parent="android:Widget.Material.Light.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:background">@drawable/btn_secondary</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textColor">@color/huafei_green</item>
        <item name="android:textSize">18sp</item>
    </style>
</resources>
