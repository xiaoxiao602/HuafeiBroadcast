<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/page_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/white">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="首次使用"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:text="请家属完成下面两步,完成后即可查询话费。中途被其他页面挡住不用担心,回到本页会看到最新进度。"
                android:textSize="16sp"
                android:textColor="@color/text_gray" />

            <TextView
                style="@style/SectionTitle"
                android:text="第 1 步:授权短信与电话" />

            <LinearLayout style="@style/Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="44dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="发送短信"
                        android:textSize="19sp"
                        android:textColor="@color/text_dark" />

                    <TextView
                        android:id="@+id/permSendState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="18sp" />
                </LinearLayout>

                <View style="@style/CardDivider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="44dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="接收短信"
                        android:textSize="19sp"
                        android:textColor="@color/text_dark" />

                    <TextView
                        android:id="@+id/permRecvState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="18sp" />
                </LinearLayout>

                <View style="@style/CardDivider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="44dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="读取手机卡信息"
                        android:textSize="19sp"
                        android:textColor="@color/text_dark" />

                    <TextView
                        android:id="@+id/permPhoneState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="18sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/permStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:minHeight="32dp"
                    android:textSize="17sp"
                    android:textColor="@color/text_gray" />

                <Button
                    android:id="@+id/grantBtn"
                    style="@style/PrimaryButton"
                    android:layout_marginTop="8dp"
                    android:text="一键授权" />

                <LinearLayout
                    android:id="@+id/deniedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <View style="@style/CardDivider" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="有权限被拒绝且勾选了「不再询问」,点「一键授权」不会再弹窗。请点下方按钮,在系统设置 → 权限里手动打开短信和电话权限。"
                        android:textSize="16sp"
                        android:textColor="@color/error_red" />

                    <Button
                        android:id="@+id/appDetailsBtn"
                        style="@style/SecondaryButton"
                        android:layout_marginTop="10dp"
                        android:text="打开系统应用设置" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/miuiBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <View style="@style/CardDivider" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="小米/红米手机第 2 步:点下方按钮打开权限页,点「其他权限」,往下滑到「设置相关」,点「通知类短信」,选「始终允许」。收不到运营商的回复短信,多半是这步没做。"
                        android:textSize="16sp"
                        android:textColor="@color/text_dark" />

                    <Button
                        android:id="@+id/miuiPermBtn"
                        style="@style/SecondaryButton"
                        android:layout_marginTop="10dp"
                        android:text="打开安全中心权限页" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/SectionTitle"
                android:text="第 2 步:选择运营商" />

            <LinearLayout style="@style/Card">

                <RadioGroup
                    android:id="@+id/setupCarrierGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/setupRbMobile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:buttonTint="@color/control_tint"
                        android:text="中国移动(发 YE 到 10086)"
                        android:textSize="20sp"
                        android:textColor="@color/text_dark" />

                    <RadioButton
                        android:id="@+id/setupRbUnicom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:buttonTint="@color/control_tint"
                        android:text="中国联通(发 102 到 10010)"
                        android:textSize="20sp"
                        android:textColor="@color/text_dark" />

                    <RadioButton
                        android:id="@+id/setupRbTelecom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:buttonTint="@color/control_tint"
                        android:text="中国电信(发 102 到 10001)"
                        android:textSize="20sp"
                        android:textColor="@color/text_dark" />
                </RadioGroup>
            </LinearLayout>

            <Button
                android:id="@+id/doneBtn"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/btn_green"
                android:stateListAnimator="@null"
                android:text="完成,开始使用"
                android:textSize="26sp"
                android:textColor="@color/white"
                android:enabled="false"
                android:alpha="0.5" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="运营商选错了也没关系,之后在「家属设置」里可以改"
                android:textSize="14sp"
                android:textColor="@color/text_gray" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
