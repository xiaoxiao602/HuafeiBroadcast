<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/page_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/white">

        <TextView
            android:id="@+id/backBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:contentDescription="返回"
            android:drawableStart="@drawable/ic_back"
            android:drawablePadding="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="家属设置"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:text="本应用不会联网,短信内容仅在本机处理。"
                android:textSize="16sp"
                android:textColor="@color/text_gray" />

            <TextView
                style="@style/SectionTitle"
                android:text="一、选择查询用的手机卡" />

            <LinearLayout style="@style/Card">
                <LinearLayout
                    android:id="@+id/simContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <TextView
                style="@style/SectionTitle"
                android:text="二、运营商与查询指令" />

            <LinearLayout style="@style/Card">

                <RadioGroup
                    android:id="@+id/carrierGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbMobile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:buttonTint="@color/control_tint"
                        android:text="中国移动 (10086)"
                        android:textSize="21sp"
                        android:textColor="@color/text_dark" />

                    <RadioButton
                        android:id="@+id/rbUnicom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:buttonTint="@color/control_tint"
                        android:text="中国联通 (10010)"
                        android:textSize="21sp"
                        android:textColor="@color/text_dark" />

                    <RadioButton
                        android:id="@+id/rbTelecom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:buttonTint="@color/control_tint"
                        android:text="中国电信 (10001)"
                        android:textSize="21sp"
                        android:textColor="@color/text_dark" />
                </RadioGroup>

                <TextView
                    style="@style/FieldLabel"
                    android:layout_marginTop="16dp"
                    android:text="查询号码(可修改)" />

                <EditText
                    android:id="@+id/queryNumberEt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_edittext"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:inputType="phone"
                    android:textSize="22sp"
                    android:textColor="@color/text_dark"
                    android:minHeight="56dp" />

                <TextView
                    style="@style/FieldLabel"
                    android:layout_marginTop="14dp"
                    android:text="查询短信内容(可修改)" />

                <EditText
                    android:id="@+id/queryCommandEt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_edittext"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:textSize="22sp"
                    android:textColor="@color/text_dark"
                    android:minHeight="56dp" />

                <Button
                    android:id="@+id/resetCmdBtn"
                    style="@style/SecondaryButton"
                    android:layout_marginTop="12dp"
                    android:text="恢复默认号码与指令" />
            </LinearLayout>

            <TextView
                style="@style/SectionTitle"
                android:text="三、其他选项" />

            <LinearLayout style="@style/Card">

                <Switch
                    android:id="@+id/autoQuerySw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:thumbTint="@color/switch_thumb"
                    android:trackTint="@color/switch_track"
                    android:text="打开App时自动查询话费"
                    android:textSize="20sp"
                    android:textColor="@color/text_dark" />

                <View style="@style/CardDivider" />

                <Switch
                    android:id="@+id/vibrateSw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:thumbTint="@color/switch_thumb"
                    android:trackTint="@color/switch_track"
                    android:text="查询时震动提醒"
                    android:textSize="20sp"
                    android:textColor="@color/text_dark" />

                <View style="@style/CardDivider" />

                <Switch
                    android:id="@+id/debugSw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:thumbTint="@color/switch_thumb"
                    android:trackTint="@color/switch_track"
                    android:text="调试模式(保存收到的原始短信)"
                    android:textSize="18sp"
                    android:textColor="@color/text_dark" />

                <View style="@style/CardDivider" />

                <TextView
                    style="@style/FieldLabel"
                    android:layout_marginTop="4dp"
                    android:text="语音播报语速" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <SeekBar
                        android:id="@+id/rateBar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:progressTint="@color/huafei_green"
                        android:thumbTint="@color/huafei_green" />

                    <TextView
                        android:id="@+id/rateValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="4dp"
                        android:text="x1.0"
                        android:textSize="20sp"
                        android:textColor="@color/text_dark" />
                </LinearLayout>

                <Button
                    android:id="@+id/ttsTestBtn"
                    style="@style/PrimaryButton"
                    android:layout_marginTop="14dp"
                    android:text="测试语音播报" />
            </LinearLayout>

            <TextView
                style="@style/SectionTitle"
                android:text="四、短信解析测试" />

            <LinearLayout style="@style/Card">

                <EditText
                    android:id="@+id/parseEt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_edittext"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:hint="粘贴一段运营商短信,例如:您的账户可用余额为36.20元"
                    android:textColorHint="@color/text_gray"
                    android:minLines="2"
                    android:textSize="18sp"
                    android:textColor="@color/text_dark" />

                <Button
                    android:id="@+id/parseBtn"
                    style="@style/PrimaryButton"
                    android:layout_marginTop="12dp"
                    android:text="测试解析" />

                <TextView
                    android:id="@+id/parseResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="40dp"
                    android:textSize="19sp"
                    android:textColor="@color/text_dark" />

                <Button
                    android:id="@+id/simulateSmsBtn"
                    style="@style/SecondaryButton"
                    android:layout_marginTop="8dp"
                    android:text="模拟收到余额短信(5秒后,可按Home键测试后台播报)" />

                <TextView
                    android:id="@+id/rawSmsTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="15sp"
                    android:textColor="@color/text_gray" />
            </LinearLayout>

            <TextView
                style="@style/SectionTitle"
                android:text="五、短信权限" />

            <LinearLayout style="@style/Card">

                <Button
                    android:id="@+id/permBtn"
                    style="@style/PrimaryButton"
                    android:text="授权短信权限" />

                <Button
                    android:id="@+id/miuiPermBtn"
                    style="@style/SecondaryButton"
                    android:layout_marginTop="10dp"
                    android:text="小米权限设置(收不到短信时点这里)" />
            </LinearLayout>

            <TextView
                style="@style/SectionTitle"
                android:text="检查更新" />

            <LinearLayout style="@style/Card">

                <Button
                    android:id="@+id/checkUpdateBtn"
                    style="@style/PrimaryButton"
                    android:text="检查更新(有新版本可直接下载)" />

                <TextView
                    android:id="@+id/updateStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="32dp"
                    android:textSize="17sp"
                    android:textColor="@color/text_gray" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
